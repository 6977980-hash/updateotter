  "tools": [
    {
      "key": "calculator",
      "path": "calculator",
      "label__en": "Fisch Fish Value Calculator",
      "formula_plain__en": [
        "Sell value = C$ per kg × weight in kg × mutation multiplier × Shiny (×1.85) × Sparkling (×1.85), rounded.",
        "No weight entered: the fish's average weight from the wiki is used. No mutation counts as ×1.",
        "A fish carries at most one mutation; Shiny and Sparkling are attributes that come on top of it."
      ],
      "slices": [
        "core",
        "fish"
      ],
      "inputs": [
        {
          "key": "fish",
          "type": "ref",
          "target": "FSH",
          "label__en": "Fish",
          "group_by": "rarity_id"
        },
        {
          "key": "weight",
          "type": "number",
          "label__en": "Weight in kg (optional)",
          "optional": true,
          "min": 0.01,
          "max": 10000000
        },
        {
          "key": "mutation",
          "type": "ref",
          "target": "MUT",
          "label__en": "Mutation",
          "optional": true,
          "none_label__en": "No mutation"
        },
        {
          "key": "attribute",
          "type": "ref",
          "target": "ATR",
          "label__en": "Shiny or Sparkling",
          "optional": true,
          "none_label__en": "Neither"
        },
        {
          "key": "attribute2",
          "type": "ref",
          "target": "ATR",
          "label__en": "Second attribute",
          "optional": true,
          "none_label__en": "None",
          "mini": false
        }
      ]
    }
